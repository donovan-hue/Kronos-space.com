{
  "name": "kronos-space-server",
  "version": "1.0.0",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "NODE_ENV=test node --test",
    "test:e2e": "NODE_ENV=test node --test --test-concurrency=1 test/*.e2e.test.js",
    "coverage": "NODE_ENV=test node --test --experimental-test-coverage --test-coverage-include='src/**' 2>&1 | node ../scripts/ci/cobertura-minima.mjs --suite=server"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.4",
    "multer": "^2.5.0",
    "openai": "^6.49.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3"
  }
}
