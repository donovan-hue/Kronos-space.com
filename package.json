{
  "name": "kronos-space",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "client": "npm run dev --workspace=client",
    "server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "lint": "npm run lint --workspace=client",
    "lint:client": "npm run lint --workspace=client",
    "test": "npm test --workspace=server && npm test --workspace=client",
    "test:server": "npm test --workspace=server",
    "test:client": "npm test --workspace=client",
    "test:e2e": "npm run test:e2e --workspace=server",
    "db:inventory": "node scripts/db/inventory.js",
    "db:code-inventory": "node scripts/db/code-inventory.js --markdown",
    "db:schema": "node scripts/db/schema-audit.js --markdown",
    "db:migrate": "node scripts/db/migrate.js",
    "db:validate": "node scripts/db/validate-data.js",
    "db:index-audit": "node scripts/db/index-audit.js",
    "db:media-orphans": "node scripts/db/media-orphans.js",
    "db:seed-staging": "node scripts/db/seed-staging.js",
    "db:bench": "node scripts/db/bench-queries.js",
    "db:rollback-drill": "node scripts/db/rollback-drill.js",
    "db:detection-drill": "node scripts/db/detection-drill.js",
    "backup:verify": "node scripts/backup-verify.js",
    "smoke:openrouter": "node scripts/openrouter-smoke.js",
    "smoke:openrouter:wire": "node scripts/openrouter-smoke.js --wire",
    "smoke:openrouter:deployed": "node scripts/openrouter-smoke.js --deployed",
    "probar": "node scripts/kairos-probadores.js",
    "probar:vivo": "node scripts/kairos-probadores.js --vivo",
    "probar:voz": "node scripts/kairos-probadores.js --voz",
    "probar:imagen": "node scripts/kairos-probadores.js --imagen",
    "probar:guion": "node scripts/kairos-probadores.js --guion",
    "probar:video": "node scripts/kairos-probadores.js --video",
    "probar:chat": "node scripts/kairos-probadores.js --chat"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "lightningcss": "^1.33.0"
  }
}
