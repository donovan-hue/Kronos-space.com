# Plantilla canónica. Copiar a server/.env y sustituir los valores de ejemplo.
PORT=5000
# Solo `development` y `test` construyen índices al arrancar. Cualquier otro
# valor, y también dejarlo vacío o sin definir, se trata como producción: los
# índices pasan a ser responsabilidad de la migración 004.
NODE_ENV=development

# MongoDB Atlas or another persistent MongoDB deployment. No in-memory fallback.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/kronos_social_ai?retryWrites=true&w=majority
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
# Creación automática de índices al arrancar. Manda sobre NODE_ENV en los dos
# sentidos. En producción se deja en false: los índices los crea la migración
# 004 (node scripts/db/migrate.js up). Al conectar, el servidor imprime
# `entorno=<valor> autoIndex=<valor>`: esa línea es la comprobación previa
# antes de cualquier migración.
MONGODB_AUTO_INDEX=false

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Duración del access token (JWT). Sin valor: 7d, comportamiento histórico.
JWT_EXPIRES_IN=7d

# Clave de cifrado de las cápsulas del tiempo (AES-256-GCM con clave
# derivada por scrypt). Si falta, se deriva de JWT_SECRET: funciona, pero
# rotar JWT_SECRET volvería ilegibles las cápsulas ya escritas. Define un
# valor propio y guárdalo como el resto de secretos.
# Documentación: docs/server/KRONOS-CAPSULES.md
CAPSULE_SECRET=

# Host canónico usado en las respuestas de federación (WebFinger/ActivityPub).
# Sin valor: kronos-space.com. El perfil público usa CLIENT_URL. En producción,
# actor, inbox, outbox y /uploads usan https://api.<CANONICAL_HOST>.
CANONICAL_HOST=kronos-space.com

# Refresh token con rotación (KRONOS-UI-007). Sin valor: 30d.
JWT_REFRESH_EXPIRES_IN=30d

# Comma-separated browser origins. En producción el PRIMERO debe ser siempre
# https://kronos-space.com porque también se usa para construir enlaces de
# correo y referencias externas. No publiques URLs de Vercel/Render al usuario.
# Producción: CLIENT_URL=https://kronos-space.com,https://www.kronos-space.com
CLIENT_URL=http://localhost:3000

# Actívalo solo tras un proxy conocido (por ejemplo Render), para que req.ip
# y los rate limits usen el primer salto confiable.
TRUST_PROXY=0

# Límites de peticiones (opcionales). Sin valor: 300 API / 60 acciones /
# 20 credenciales por 15 minutos. Se suben en pruebas E2E reales.
API_RATE_LIMIT_MAX=
ABUSE_RATE_LIMIT_MAX=
AUTH_RATE_LIMIT_MAX=

# Optional providers
GEMINI_API_KEY=
# Vacío usa el default de config/aiProviders.js. Verificar el modelo con
# el proveedor antes de producción; esta plantilla no certifica disponibilidad.
GEMINI_MODEL=

# OpenRouter: guion e imagen. Sin OPENROUTER_API_KEY las rutas /api/ai/scripts
# y /api/ai/images responden 503 (no hay resultados simulados).
# Prueba de humo real: npm run smoke:openrouter (requiere clave).
# Solo cableado y catálogo: npm run smoke:openrouter:wire (sin clave).
# Ver docs/server/KRONOS-OPENROUTER.md.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# Solo se envía si el modelo lo declara en el catálogo de OpenRouter; si no,
# se usa OPENROUTER_IMAGE_ASPECT_RATIO para conservar el encuadre.
OPENROUTER_IMAGE_SIZE=1024x1024
OPENROUTER_IMAGE_ASPECT_RATIO=1:1

# Voz (locución): usa la MISMA OPENROUTER_API_KEY. Vacíos usan los valores por
# defecto de voiceSettings.js (x-ai/grok-voice-tts-1.0, voz "eve"). El endpoint
# es /api/v1/audio/speech y devuelve un MP3 que se guarda en /uploads/voices/.
# Sin la llave, POST /api/voices/locucion responde 503 y la pestaña Voz del
# estudio lo dice en pantalla.
OPENROUTER_TTS_MODEL=x-ai/grok-voice-tts-1.0
OPENROUTER_TTS_VOICE=eve

# Vacío = proveedor oficial (https://openrouter.ai/api/v1). Definirlo apunta a
# un gateway compatible y la prueba de humo lo marca como NO verificado.
OPENROUTER_BASE_URL=
VIDEO_API_KEY=
VIDEO_API_URL=
# Vacío usa el default de config/aiProviders.js; requiere endpoint real.
VIDEO_MODEL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# "Continuar con Google" (Google Identity Services). SOLO el Client ID:
# no hay Client Secret — el navegador entrega el ID token firmado por
# Google y este servidor lo verifica con google-auth-library.
# Genera el Client ID en Google Cloud Console > APIs y servicios >
# Credenciales > Crear credenciales > ID de cliente de OAuth > Web,
# agregando como "Orígenes de JavaScript autorizados" los dominios del
# frontend (p. ej. http://localhost:3000 y https://kronos-space.com).
# Sin esta variable el botón de Google queda desactivado (enabled=false).
GOOGLE_CLIENT_ID=

# ==========================================================
# FEATURE FLAGS (FASE 0)
# ==========================================================
# El cliente los pregunta una vez al arrancar en GET /api/flags. Vacío o sin
# definir = el default del código, que es `true` en los seis (todo lo ya
# publicado en el dominio va encendido). `true|1` activa, `false|0` apaga.
# Cualquier otro valor se ignora y deja el default.
# No hay flags por usuario: esto es liberación, no segmentación.
FEATURE_FLAG_AI_COMPOSER=
FEATURE_FLAG_CAPSULES=
FEATURE_FLAG_PULSE=
FEATURE_FLAG_VERTICAL=
FEATURE_FLAG_ANALYTICS=
FEATURE_FLAG_ARCHIVE=

# ==========================================================
# MIGRACIONES (solo las ejecuta `npm run db:migrate`, nunca el servidor)
# ==========================================================
# Retención de notificaciones en días. SIN esta variable la migración 005 no
# crea ningún índice TTL: un TTL borra documentos y eso nunca se activa por
# omisión. Mínimo 7 días; por debajo la precondición rechaza la migración.
NOTIFICATIONS_TTL_DAYS=

# Confirmación explícita para migrar una base de producción. Alternativa a
# `--confirm <nombre-de-la-base>`; debe repetir el nombre exacto de la base.
# Sin ella el corredor falla con MIGRATION_CONFIRMATION_REQUIRED.
KRONOS_MIGRATION_CONFIRM=

# ==========================================================
# HERRAMIENTAS DE OPERACIÓN (scripts/, no las lee el servidor)
# ==========================================================
# Base de la API para las sondas: `npm run probar` y `npm run db:*`.
# Sin valor usan el despliegue real. Para producción:
#   BASE=https://api.kronos-space.com
BASE=
# Token de acceso para las sondas autenticadas de `npm run probar`.
TOKEN=

# Prueba de humo de OpenRouter (`npm run smoke:openrouter`).
# SMOKE_IMAGE=1 añade una imagen real a la comprobación: es la única parte
# facturada. Sin él solo se verifica el guion.
SMOKE_IMAGE=
SMOKE_IMAGE_PROMPT=
SMOKE_SCRIPT_PROMPT=
SMOKE_TIMEOUT_MS=

# Ensayo de restauración de producción (`scripts/ci/prepare-production-restore-fixture.js`).
# URI de destino del ensayo; nunca la de producción real.
MONGODB_TARGET_URI=

# Ignorar el archivo .env al arrancar las herramientas de base de datos:
# fuerza a declarar la URI por entorno en vez de heredar la del desarrollador.
KRONOS_IGNORE_ENV_FILE=
