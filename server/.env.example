# Required runtime configuration. Copy to server/.env and replace every value.
PORT=5000
NODE_ENV=development

# MongoDB Atlas or another persistent MongoDB deployment. No in-memory fallback.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/kronos_social_ai?retryWrites=true&w=majority
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Duración del access token (JWT). Sin valor: 7d, comportamiento histórico.
JWT_EXPIRES_IN=7d

# Refresh token con rotación (KRONOS-UI-007). Sin valor: 30d.
JWT_REFRESH_EXPIRES_IN=30d

# Comma-separated browser origins.
CLIENT_URL=http://localhost:3000

# Optional providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=
OPENROUTER_MODEL=
VIDEO_API_KEY=
VIDEO_API_URL=
VIDEO_MODEL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
