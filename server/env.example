```env
PORT=5000
NODE_ENV=development

MONGODB_URI=
JWT_SECRET=

# Orígenes públicos separados por coma; no uses comodines en producción.
# El primero es el canónico para enlaces: https://kronos-space.com
# Producción: CLIENT_URL=https://kronos-space.com,https://www.kronos-space.com
CLIENT_URL=http://localhost:3000
# Solo detrás de un proxy conocido (Render): 1. En desarrollo: 0.
TRUST_PROXY=0

# IA — OpenRouter (guion e imagen). Prueba de humo real:
#   npm run smoke:openrouter          (requiere esta clave)
#   npm run smoke:openrouter:wire     (solo cableado y catálogo, sin clave)
# Ver docs/server/KRONOS-OPENROUTER.md.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
OPENROUTER_IMAGE_SIZE=1024x1024
OPENROUTER_IMAGE_ASPECT_RATIO=1:1
OPENROUTER_BASE_URL=

# IA — Video
VIDEO_API_URL=
VIDEO_API_KEY=
VIDEO_MODEL=video-generation

# Correo transaccional para recuperación y verificación de email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Client ID público de Google Identity Services (sin Client Secret).
GOOGLE_CLIENT_ID=

# Compatibilidad / proveedores futuros
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
```
