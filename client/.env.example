# ==========================================
# KRONOS SOCIAL AI — CLIENT ENVIRONMENT
# ==========================================

# Backend API base URL.
# El cliente utiliza el prefijo /api.
# Leave this empty for same-origin deployments and the Vite proxy.
VITE_API_URL=/api

# Producción:
# VITE_API_URL=https://TU-API-DE-PRODUCCION/api

# Socket.IO utiliza el host del backend,
# sin el sufijo /api.

# No colocar claves secretas aquí.
