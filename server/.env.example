# Plantilla canónica. Copiar a server/.env y sustituir los valores de ejemplo.
PORT=5000
NODE_ENV=development

# MongoDB Atlas or another persistent MongoDB deployment. No in-memory fallback.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/kronos_social_ai?retryWrites=true&w=majority
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Duración del access token (JWT). Sin valor: 7d, comportamiento histórico.
JWT_EXPIRES_IN=7d

# Clave de cifrado de las cápsulas del tiempo (AES-256-GCM con clave
# derivada por scrypt). Si falta, se deriva de JWT_SECRET: funciona, pero
# rotar JWT_SECRET volvería ilegibles las cápsulas ya escritas. Define un
# valor propio y guárdalo como el resto de secretos.
# Documentación: docs/server/KRONOS-CAPSULES.md
CAPSULE_SECRET=

# Host canónico usado en las respuestas de federación (WebFinger/ActivityPub).
# Sin valor: kronos-space.com. El perfil público usa CLIENT_URL. En producción,
# actor, inbox, outbox y /uploads usan https://api.<CANONICAL_HOST>.
CANONICAL_HOST=kronos-space.com

# Refresh token con rotación (KRONOS-UI-007). Sin valor: 30d.
JWT_REFRESH_EXPIRES_IN=30d

# Comma-separated browser origins. En producción el PRIMERO debe ser siempre
# https://kronos-space.com porque también se usa para construir enlaces de
# correo y referencias externas. No publiques URLs de Vercel/Render al usuario.
# Producción: CLIENT_URL=https://kronos-space.com,https://www.kronos-space.com
CLIENT_URL=http://localhost:3000

# Actívalo solo tras un proxy conocido (por ejemplo Render), para que req.ip
# y los rate limits usen el primer salto confiable.
TRUST_PROXY=0

# Límites de peticiones (opcionales). Sin valor: 300 API / 60 acciones /
# 20 credenciales por 15 minutos. Se suben en pruebas E2E reales.
API_RATE_LIMIT_MAX=
ABUSE_RATE_LIMIT_MAX=
AUTH_RATE_LIMIT_MAX=

# Optional providers
GEMINI_API_KEY=
# Vacío usa el default de config/aiProviders.js. Verificar el modelo con
# el proveedor antes de producción; esta plantilla no certifica disponibilidad.
GEMINI_MODEL=

# OpenRouter: guion e imagen. Sin OPENROUTER_API_KEY las rutas /api/ai/scripts
# y /api/ai/images responden 503 (no hay resultados simulados).
# Prueba de humo real: npm run smoke:openrouter (requiere clave).
# Solo cableado y catálogo: npm run smoke:openrouter:wire (sin clave).
# Ver docs/server/KRONOS-OPENROUTER.md.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# Solo se envía si el modelo lo declara en el catálogo de OpenRouter; si no,
# se usa OPENROUTER_IMAGE_ASPECT_RATIO para conservar el encuadre.
OPENROUTER_IMAGE_SIZE=1024x1024
OPENROUTER_IMAGE_ASPECT_RATIO=1:1

# Vacío = proveedor oficial (https://openrouter.ai/api/v1). Definirlo apunta a
# un gateway compatible y la prueba de humo lo marca como NO verificado.
OPENROUTER_BASE_URL=
VIDEO_API_KEY=
VIDEO_API_URL=
# Vacío usa el default de config/aiProviders.js; requiere endpoint real.
VIDEO_MODEL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# "Continuar con Google" (Google Identity Services). SOLO el Client ID:
# no hay Client Secret — el navegador entrega el ID token firmado por
# Google y este servidor lo verifica con google-auth-library.
# Genera el Client ID en Google Cloud Console > APIs y servicios >
# Credenciales > Crear credenciales > ID de cliente de OAuth > Web,
# agregando como "Orígenes de JavaScript autorizados" los dominios del
# frontend (p. ej. http://localhost:3000 y https://kronos-space.com).
# Sin esta variable el botón de Google queda desactivado (enabled=false).
GOOGLE_CLIENT_ID=
