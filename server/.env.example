# Required runtime configuration. Copy to server/.env and replace every value.
PORT=5000
NODE_ENV=development

# MongoDB Atlas or another persistent MongoDB deployment. No in-memory fallback.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/kronos_social_ai?retryWrites=true&w=majority
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Duración del access token (JWT). Sin valor: 24h. El frontend renueva
# con el refresh token en segundo plano, así que 24h es seguro sin fricción.
JWT_EXPIRES_IN=24h

# Refresh token con rotación (KRONOS-UI-007). Sin valor: 30d.
JWT_REFRESH_EXPIRES_IN=30d

# Comma-separated browser origins. En producción el PRIMERO debe ser siempre
# https://kronos-space.com porque también se usa para construir enlaces de
# correo y referencias externas. No publiques URLs de Vercel/Render al usuario.
# Producción: CLIENT_URL=https://kronos-space.com,https://www.kronos-space.com
CLIENT_URL=http://localhost:3000

# Actívalo solo tras un proxy conocido (por ejemplo Render), para que req.ip
# y los rate limits usen el primer salto confiable.
TRUST_PROXY=0

# Límites de peticiones (opcionales). Sin valor: 300 API / 60 acciones /
# 20 por IP y 10 por cuenta (ip+email) en credenciales por 15 minutos.
# Se suben en pruebas E2E reales.
API_RATE_LIMIT_MAX=
ABUSE_RATE_LIMIT_MAX=
AUTH_RATE_LIMIT_MAX=
EMAIL_AUTH_RATE_LIMIT_MAX=

# Optional providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=
OPENROUTER_MODEL=
VIDEO_API_KEY=
VIDEO_API_URL=
VIDEO_MODEL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Redis (opcional pero recomendado en producción): presencia multi-instancia
# y pub/sub de Socket.IO. Sin esta variable la presencia funciona en memoria
# (una sola instancia). Formato: redis://USER:PASSWORD@HOST:PORT
REDIS_URL=

# Clave ANTERIOR de cápsulas, solo para descifrar (rotación). El cifrado usa
# siempre CAPSULE_SECRET. Igual formato que CAPSULE_SECRET (64 hex).
CAPSULE_SECRET_PREV=

# Concurrencia máxima de la cola de notificaciones (defecto: 5).
NOTIFICATION_CONCURRENCY=

# Saltar la consulta HIBP de contraseñas filtradas (defecto: solo en NODE_ENV=test).
# NO activar en producción.
KRONOS_SKIP_HIBP=

# Cookie del refresh token (httpOnly + SameSite=Lax, Path=/api/auth).
# `Secure` se activa solo en producción; este override lo fuerza (=1) o
# lo desactiva (=0). En staging con HTTPS conviene KRONOS_COOKIE_SECURE=1.
KRONOS_COOKIE_SECURE=

# "Continuar con Google" (Google Identity Services). SOLO el Client ID:
# no hay Client Secret — el navegador entrega el ID token firmado por
# Google y este servidor lo verifica con google-auth-library.
# Genera el Client ID en Google Cloud Console > APIs y servicios >
# Credenciales > Crear credenciales > ID de cliente de OAuth > Web,
# agregando como "Orígenes de JavaScript autorizados" los dominios del
# frontend (p. ej. http://localhost:3000 y https://kronos-space.com).
# Sin esta variable el botón de Google queda desactivado (enabled=false).
GOOGLE_CLIENT_ID=
